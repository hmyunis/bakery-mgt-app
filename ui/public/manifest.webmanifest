{
    "id": "/",
    "name": "Siro Bakery Management",
    "short_name": "Siro",
    "description": "Siro Bakery's secure management platform for sales, production, inventory, staff, and treasury operations.",
    "lang": "en",
    "dir": "ltr",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
    "orientation": "any",
    "background_color": "#faf7ed",
    "theme_color": "#8b4d20",
    "categories": ["business", "productivity", "finance"],
    "prefer_related_applications": false,
    "icons": [
        {
            "src": "/icons/pwa-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/pwa-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/pwa-maskable-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Sales",
            "short_name": "Sales",
            "description": "Open the point of sale",
            "url": "/app/sales",
            "icons": [{ "src": "/icons/pwa-192x192.png", "sizes": "192x192" }]
        },
        {
            "name": "Production",
            "short_name": "Production",
            "description": "Open production management",
            "url": "/app/production",
            "icons": [{ "src": "/icons/pwa-192x192.png", "sizes": "192x192" }]
        },
        {
            "name": "Inventory",
            "short_name": "Inventory",
            "description": "Open inventory management",
            "url": "/app/inventory",
            "icons": [{ "src": "/icons/pwa-192x192.png", "sizes": "192x192" }]
        }
    ],
    "launch_handler": {
        "client_mode": "navigate-existing"
    }
}
